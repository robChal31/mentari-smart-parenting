# Berkas unggahan runtime (disajikan API, jangan masuk repo).
#
# HANYA folder data di root dan di apps/api. JANGAN pakai pola `uploads/` polos:
# pola itu juga mencocokkan `apps/api/src/uploads/` — folder KODE SUMBER modul
# upload — sehingga file .ts-nya tidak pernah ter-commit dan build gagal dengan
# "Cannot find module './uploads/uploads.module'".
/uploads/
apps/api/uploads/

# Folder artefak deploy yang dirakit workflow (hasil build, bukan sumber)
/deploy/

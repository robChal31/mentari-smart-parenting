# ============================================================
# MentariSmartParent — Environment Variables
# ============================================================

# ============ DATABASE ============
# Production (MySQL via docker-compose or managed instance):
# DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"   # runtime API
DATABASE_URL="postgresql://postgres:Kadugajah31@db.haflgizxvkmgfufooxbt.supabase.co:5432/postgres"   # runtime API
SUPABASE_DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"   # khusus db:push

# Local dev fallback (SQLite, works out of the box — use schema.sqlite.prisma):
# DATABASE_URL="file:./dev.db"

# ============ AUTH ============
# Dev mode (default): the API issues its own HS256 tokens so the app works
# without external services. Set SUPABASE_JWT_SECRET to validate real
# Supabase-issued tokens instead.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
SUPABASE_JWT_SECRET=""

# ============ API (apps/api) ============
API_PORT=4000
API_PREFIX="api/v1"
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# ============ WEB (apps/web) ============
NEXT_PUBLIC_SITE_URL="http://localhost:3000"  # used for canonical URLs, sitemap, robots
# Server-side base URL the Next.js server uses to reach the API:
API_INTERNAL_URL="http://localhost:4000"  # server-side only; /api/* is proxied by Next rewrites
# Browser never calls the API directly — /api/* is proxied by Next.js rewrites.

# ============ MISC ============
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================================
# MentariSmartParent — Environment Variables
# ============================================================

# ============ DATABASE ============
# Production (MySQL via docker-compose or managed instance):
DATABASE_URL="mysql://mentari:mentari_password@localhost:3306/mentari_smartparent"
# Local dev fallback (SQLite, works out of the box — use schema.sqlite.prisma):
# DATABASE_URL="file:./dev.db"
# Supabase (PostgreSQL): runtime uses the DIRECT connection (5432) or the
# session pooler; schema push must use the direct connection.
# DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
# Used ONLY by `pnpm --filter=@mentari/database db:push:supabase`:
SUPABASE_DATABASE_URL=""

# ============ AUTH ============
# Dev mode (default): the API issues its own HS256 tokens so the app works
# without external services. Set SUPABASE_JWT_SECRET to validate real
# Supabase-issued tokens instead.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
SUPABASE_JWT_SECRET=""
# Find it in Supabase Dashboard → Project Settings → API → JWT Secret.
# When set, POST /auth/login is bypassed and the API verifies Supabase-issued
# access tokens (aud "authenticated"); local users are provisioned on first login.

# ============ API (apps/api) ============
API_PORT=4000
API_PREFIX="api/v1"
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# ============ WEB (apps/web) ============
NEXT_PUBLIC_SITE_URL="http://localhost:3000"  # used for canonical URLs, sitemap, robots
# Server-side base URL the Next.js server uses to reach the API:
API_INTERNAL_URL="http://localhost:4000"  # server-side only; /api/* is proxied by Next rewrites
# Browser never calls the API directly — /api/* is proxied by Next.js rewrites.

# ============ MISC ============
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

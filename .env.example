# ============================================================
# MentariSmartParent — Environment Variables
# ============================================================
# Copy this file to `.env` at the REPOSITORY ROOT (same folder as this
# file) and fill in real values. The API, the database scripts and the
# Prisma CLI configs all auto-load the nearest .env walking UP from cwd
# (Node ≥ 20.12, built-in — no extra packages), so one root .env covers
# `pnpm db:*` and the API.
#
# The web app (Next.js) is different: it only reads .env* inside
# apps/web/. For production builds set web vars in your hosting env or
# apps/web/.env.local (see WEB section below).
#
# NEVER commit real credentials — .env is gitignored, .env.example is not.
# ============================================================

# ============ DATABASE ============
# PostgreSQL yang berjalan di VPS yang sama dengan aplikasi.
# Ganti <password> dengan kata sandi yang kamu buat sendiri.
DATABASE_URL="postgresql://mentari:<password>@127.0.0.1:5432/mentari_smartparent"

# TLS hanya diperlukan bila database TIDAK berada di loopback (mis. server
# terpisah). Untuk Postgres lokal biarkan komentar di bawah.
# DATABASE_SSL="true"
# DATABASE_SSL_STRICT="true"   # aktifkan bila sertifikat server valid

# ============ AUTH ============
# WAJIB diisi di produksi: API menolak start (NODE_ENV=production) bila kosong
# atau masih memakai nilai contoh, karena setiap token sesi ditandatangani
# dengan kunci ini.
#   Buat dengan:  openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ============ UPLOAD (thumbnail & media) ============
# Folder tempat berkas unggahan disimpan. WAJIB berada di disk yang persisten —
# jangan di dalam folder yang dihapus saat rebuild/deploy.
UPLOAD_DIR="./uploads"

# URL publik untuk berkas itu. Dibuat relatif supaya domain tidak tertanam
# di database; web mem-proxy /uploads/* ke API.
UPLOAD_PUBLIC_PATH="/uploads"

# Batas ukuran. Bisa disesuaikan dengan kapasitas VPS tanpa mengubah kode.
#   Gambar (JPG/PNG/WebP) 5 MB · GIF 8 MB · Video (MP4/WebM) 25 MB
# UPLOAD_IMAGE_MAX_BYTES=5242880
# UPLOAD_GIF_MAX_BYTES=8388608
# UPLOAD_VIDEO_MAX_BYTES=26214400
# Plafon keras di level multipart — harus >= batas video di atas.
# UPLOAD_HARD_LIMIT_BYTES=26214400

# ============ API (apps/api) ============
API_PORT=4000
API_PREFIX="api/v1"
NODE_ENV=development
# `::` = IPv4 + IPv6 sekaligus. Biarkan default kecuali kamu punya alasan lain.
# API_HOST="::"
CORS_ORIGIN="http://localhost:3000"

# ============ WEB (apps/web) ============
# Next.js DOES NOT read the root .env — put these in apps/web/.env.local
# (or in your server's env settings):
NEXT_PUBLIC_SITE_URL="http://localhost:3000"  # canonical URLs, sitemap, robots
API_INTERNAL_URL="http://127.0.0.1:4000"      # server-side only; /api/* dan /uploads/* diproxy ke API
# Browser tidak pernah memanggil API langsung — /api/* dan /uploads/* diproxy
# oleh Next.js rewrites, jadi tidak perlu membuka port API ke publik.

# ============ MISC ============
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================================
# Windows (PowerShell) notes — bash-style inline vars DON'T work there:
#   $env:DATABASE_URL="postgresql://…"; pnpm --filter=@mentari/database db:seed
# The root .env above is the recommended, shell-agnostic way.
# ============================================================

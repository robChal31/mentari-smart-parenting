# ============================================================
# MentariSmartParent — Environment Variables
# ============================================================
# Copy this file to `.env` at the REPOSITORY ROOT (same folder as this
# file) and fill in real values. The API, the database scripts and the
# Prisma CLI configs all auto-load the nearest .env walking UP from cwd
# (Node ≥ 20.12, built-in — no extra packages), so one root .env covers
# `pnpm --filter=@mentari/database db:*` and the API.
#
# The web app (Next.js) is different: it only reads .env* inside
# apps/web/. For production builds set web vars in your hosting env or
# apps/web/.env.local (see WEB section below).
#
# NEVER commit real credentials — .env is gitignored, .env.example is not.
# ============================================================

# ============ DATABASE ============
# Local dev fallback (SQLite, works out of the box):
DATABASE_URL="file:./dev.db"
# Production (MySQL):
# DATABASE_URL="mysql://mentari:mentari_password@localhost:3306/mentari_smartparent"
# Production (Supabase / PostgreSQL) — use the DIRECT connection (port 5432),
# not the pgBouncer pooler (6543) for schema pushes; runtime may use direct
# or the session pooler. The API picks @prisma/adapter-pg automatically from
# the postgresql(ql):// scheme:
# DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Used ONLY by `pnpm --filter=@mentari/database db:push:supabase`
# (schema push must not go through the transaction pooler):
SUPABASE_DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# ============ AUTH ============
# Dev mode (default): the API issues its own HS256 tokens so the app works
# without external services. Set SUPABASE_JWT_SECRET to validate real
# Supabase-issued tokens instead.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
SUPABASE_JWT_SECRET=""
# Find it in Supabase Dashboard → Project Settings → API → JWT Secret.
# NOTE: when set, POST /auth/login tokens are no longer accepted by the guard
# (it only trusts Supabase-issued `aud=authenticated` tokens). The web UI is
# not wired to Supabase Auth yet — keep this EMPTY unless you also integrate
# supabase-js in apps/web. See README → Production deployment → Auth.

# ============ API (apps/api) ============
API_PORT=4000
API_PREFIX="api/v1"
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# ============ WEB (apps/web) ============
# Next.js does NOT read the root .env — put these in apps/web/.env.local
# (or in your hosting provider's env settings):
NEXT_PUBLIC_SITE_URL="http://localhost:3000"  # canonical URLs, sitemap, robots
API_INTERNAL_URL="http://localhost:4000"      # server-side only; /api/* proxied to the API
# Browser never calls the API directly — /api/* is proxied by Next.js rewrites.

# ============ MISC ============
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================================
# Windows (PowerShell) notes — bash-style inline vars DON'T work there:
#   $env:DATABASE_URL="postgresql://…"; pnpm --filter=@mentari/database db:seed
# The root .env above is the recommended, shell-agnostic way.
# ============================================================
